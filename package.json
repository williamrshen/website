{
  "name": "personal-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "stats:refresh": "node --env-file-if-exists=.env.local scripts/cubing/refresh.mjs && npm run stats:refresh:hobbies",
    "stats:refresh:hobbies": "node scripts/hobbies/refresh-tetrio.mjs && node scripts/hobbies/refresh-mcsr.mjs",
    "test": "node --experimental-strip-types --test scripts/cubing/*.test.mjs scripts/hobbies/*.test.mjs src/garden/*.test.ts src/garden/dev/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "lz-string": "^1.5.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
